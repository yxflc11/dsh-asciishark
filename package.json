{
  "name": "@local/dsh-client-ui-ascii-ocean",
  "version": "0.10.0",
  "private": true,
  "description": "ASCII shark ocean rendered in a worker, behind an Apple Liquid Glass sidebar",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "pack:tgz": "node -e \"require('node:fs').mkdirSync('dist', { recursive: true })\" && npm pack --pack-destination dist"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  },
  "files": [
    "lib",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "license": "SEE LICENSE IN THIRD_PARTY_NOTICES.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yxflc11/dsh-asciishark.git"
  },
  "homepage": "https://github.com/yxflc11/dsh-asciishark#readme",
  "bugs": {
    "url": "https://github.com/yxflc11/dsh-asciishark/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "ascii",
    "sharks",
    "liquid-glass",
    "background",
    "plugin",
    "canvas"
  ]
}
